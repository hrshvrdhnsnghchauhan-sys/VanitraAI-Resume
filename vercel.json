{
  "version": 2,
  "builds": [
    {
      "src": "dist/server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/manifest\\.webmanifest",
      "dest": "/dist/client/manifest.webmanifest"
    },
    {
      "src": "/registerSW\\.js",
      "dest": "/dist/client/registerSW.js"
    },
    {
      "src": "/(favicon\\.svg|mask-icon\\.svg|apple-touch-icon\\.png|og-image\\.jpg|pwa-192x192\\.png|pwa-512x512\\.png|robots\\.txt|sitemap\\.xml|sw\\.js)",
      "dest": "/dist/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/server/server.js"
    }
  ]
}
