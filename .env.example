# ==========================================
# Firebase Configuration (Authentication & Firestore)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ==========================================
# AI APIs (Gemini / OpenAI)
# Note: If missing, the application automatically uses robust dummy/mock AI responses.
# ==========================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Cloudinary (Optional Storage Alternative)
# ==========================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ==========================================
# Stripe (International Payments)
# Publishable key is client-safe (public by design).
# Server-side vars must be set in Vercel:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_<PLAN>_<INTERVAL>
# ==========================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
