# ==========================================
# Firebase Configuration (Authentication & Firestore)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==========================================
# AI (Gemini)
# Real LLM calls only. If the key is missing or a call fails, the AI
# feature throws an explicit error — there is NO mock/dummy fallback.
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Stripe (International Payments)
# Publishable key is client-safe (public by design).
# All server-side vars below must be set in Vercel (never committed):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_<PLAN>_<INTERVAL>
# ==========================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER_MONTHLY=price_your_starter_monthly_id
STRIPE_PRICE_STARTER_YEARLY=price_your_starter_yearly_id
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_your_professional_monthly_id
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_your_professional_yearly_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_your_enterprise_yearly_id

# ==========================================
# Razorpay (India Payments)
# Publishable key is client-safe. Server-side secrets must be set in Vercel
# (never committed). Payments fail closed if these are unset.
# ==========================================
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_razorpay_webhook_secret

# ==========================================
# Cloudinary (Optional Storage Alternative — not required for Firebase Storage)
# ==========================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
